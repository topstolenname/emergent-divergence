# Copy to .env and fill in. run_all.sh loads this automatically.
#
#   cp .env.example .env
#   ./run_all.sh --smoke     # free offline proof (no key needed)
#   ./run_all.sh             # full matrix (Claude arm needs the key below)

# ── Paid arm (Claude) ────────────────────────────────────────────────────────
# Required only for the Claude backend. Without it, the pipeline still runs the
# free Ollama + stub arms and simply marks Claude cells "skipped_unavailable".
ANTHROPIC_API_KEY=

# ── Optional matrix overrides ────────────────────────────────────────────────
# These override configs/pipeline.yaml; CLI flags override these in turn.
# Leave commented to use the config defaults.

# ROUNDS=50                # deliberation rounds per cell
# SEEDS=42,43,44,45        # comma- or space-separated
# COST_CAP_USD=50.0        # hard spend ceiling; matrix auto-reduces to fit
# INFLUENCE_EVERY_N=5      # run the counterfactual influence probe every Nth round
# K_SAMPLES=3              # Monte-Carlo samples per probe (applied to all backends)

# Note: the Ollama model + host live in configs/pipeline.yaml (backends_cfg.ollama),
# not here. Default host is http://localhost:11434.
